{
  "name": "CRA System",
  "image": "mcr.microsoft.com/devcontainers/python:3.13-bookworm",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}/cra system",
  "remoteUser": "vscode",
  "forwardPorts": [
    8000,
    5173
  ],
  "portsAttributes": {
    "5173": {
      "label": "CRA Workbench",
      "visibility": "private",
      "onAutoForward": "silent"
    },
    "8000": {
      "label": "CRA API",
      "visibility": "private",
      "onAutoForward": "silent"
    }
  },
  "postCreateCommand": "python3 tools/check_traceability.py",
  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python"
      }
    }
  }
}
