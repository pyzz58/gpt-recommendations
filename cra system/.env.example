# Synthetic development settings. Model/storage values remain placeholders.
# Real secrets and clinical materials must never be committed.
CRA_ENV=synthetic
CRA_MODEL_PROVIDER=disabled
CRA_MODEL_API_KEY=
CRA_OCR_PROVIDER=disabled
CRA_DATABASE_URL=postgresql+psycopg://cra:synthetic@localhost:5432/cra
CRA_TEST_DATABASE_URL=postgresql+psycopg://cra:synthetic@localhost:5432/cra_test
CRA_SESSION_SECRET=synthetic-only-session-secret
CRA_SESSION_COOKIE_SECURE=false
CRA_SYNTHETIC_ACTOR_ID=synthetic-cra
CRA_SYNTHETIC_TENANT_ID=synthetic
CRA_PUBLIC_BASE_URL=http://localhost:5173
CRA_OIDC_ISSUER=
CRA_OIDC_CLIENT_ID=
CRA_OIDC_CLIENT_SECRET=
CRA_PRIVATE_STORAGE_ENDPOINT=
