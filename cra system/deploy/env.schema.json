{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/cra/deploy-env.schema.json",
  "title": "CRA approved runtime environment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "CRA_ENV",
    "CRA_DATABASE_URL",
    "CRA_SESSION_SECRET",
    "CRA_PUBLIC_BASE_URL",
    "CRA_OIDC_ISSUER",
    "CRA_OIDC_CLIENT_ID",
    "CRA_OIDC_CLIENT_SECRET",
    "CRA_STORAGE_BACKEND",
    "CRA_API_IMAGE",
    "CRA_WEB_IMAGE"
  ],
  "properties": {
    "CRA_ENV": {
      "const": "production"
    },
    "CRA_DATABASE_URL": {
      "type": "string",
      "pattern": "^postgresql\\+psycopg://[^\\s]+$"
    },
    "CRA_SESSION_SECRET": {
      "type": "string",
      "minLength": 32
    },
    "CRA_SESSION_COOKIE_SECURE": {
      "const": "true"
    },
    "CRA_PUBLIC_BASE_URL": {
      "type": "string",
      "pattern": "^https://[^\\s]+$"
    },
    "CRA_OIDC_ISSUER": {
      "type": "string",
      "pattern": "^https://[^\\s]+$"
    },
    "CRA_OIDC_CLIENT_ID": {
      "type": "string",
      "minLength": 1
    },
    "CRA_OIDC_CLIENT_SECRET": {
      "type": "string",
      "minLength": 16
    },
    "CRA_STORAGE_BACKEND": {
      "const": "s3"
    },
    "CRA_PRIVATE_STORAGE_ENDPOINT": {
      "type": "string",
      "minLength": 1
    },
    "CRA_PRIVATE_STORAGE_ACCESS_KEY": {
      "type": "string",
      "minLength": 1
    },
    "CRA_PRIVATE_STORAGE_SECRET_KEY": {
      "type": "string",
      "minLength": 1
    },
    "CRA_PRIVATE_STORAGE_BUCKET": {
      "type": "string",
      "minLength": 3
    },
    "CRA_API_IMAGE": {
      "type": "string",
      "pattern": "@sha256:[0-9a-f]{64}$"
    },
    "CRA_WEB_IMAGE": {
      "type": "string",
      "pattern": "@sha256:[0-9a-f]{64}$"
    },
    "CRA_OCR_PROVIDER": {
      "enum": ["disabled", "docling"]
    },
    "CRA_RUNTIME_BIND": {
      "type": "string"
    },
    "CRA_DB_NAME": {
      "type": "string"
    },
    "CRA_DB_USER": {
      "type": "string"
    },
    "CRA_DB_PASSWORD": {
      "type": "string",
      "minLength": 16
    },
    "CRA_MAX_UPLOAD_BYTES": {
      "type": "string",
      "pattern": "^[0-9]+$"
    }
  }
}
