# Public CI-only values for container wiring. This is not a production secret file.
CRA_ENV=test
CRA_DATABASE_URL=postgresql+psycopg://cra:ci-only-database-password@postgres:5432/cra
CRA_DB_NAME=cra
CRA_DB_USER=cra
CRA_DB_PASSWORD=ci-only-database-password
CRA_SESSION_SECRET=ci-only-session-secret-never-use-in-production
CRA_SESSION_COOKIE_SECURE=true
CRA_PUBLIC_BASE_URL=http://127.0.0.1:8080
CRA_OIDC_ISSUER=https://oidc.invalid
CRA_OIDC_CLIENT_ID=ci-only-client
CRA_OIDC_CLIENT_SECRET=ci-only-client-secret
CRA_STORAGE_BACKEND=local
CRA_PRIVATE_STORAGE_ENDPOINT=
CRA_PRIVATE_STORAGE_ACCESS_KEY=
CRA_PRIVATE_STORAGE_SECRET_KEY=
CRA_PRIVATE_STORAGE_BUCKET=cra-private
CRA_PRIVATE_STORAGE_REGION=us-east-1
CRA_API_IMAGE=cra-api:ci
CRA_WEB_IMAGE=cra-web:ci
CRA_OCR_PROVIDER=disabled
CRA_RUNTIME_BIND=127.0.0.1:8080
CRA_MAX_UPLOAD_BYTES=20971520
