{
  "name": "cra-system-web",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "engines": {
    "node": "24.22.2",
    "npm": "11.19.1"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "api:generate": "uv run --project .. --frozen python ../tools/export_openapi.py --write && openapi-typescript ../contracts/openapi.json -o src/api/generated.ts",
    "api:check": "npm run api:generate --silent && git -C .. diff --exit-code -- contracts/openapi.json web/src/api/generated.ts"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
