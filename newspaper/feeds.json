  "longread_max_chars": 6500,
  "longread_min_chars": 1400,
  "candidate_pool_per_category": 20,
  "source_limit_per_category": 2,
  "grammar_examples_per_article": 3,
  "ranking": {
    "weights": {
      "impact": 30,
      "interest": 25,
      "cross_source": 20,
      "novelty_proxy": 15,
      "recency": 10
    },
    "description": "Transparent heuristic only; outlet agreement not verified fact."
  },
  "reading_policy": {
    "mode": "consecutive_complete_paragraphs",
    "description": "Do not assemble article paragraphs from distant sections. Readable selection begins at the lead, stops cleanly at a whole-paragraph boundary; never impersonate a fully rewritten news feature.",
    "target_chinese_characters": "approximately 700-1400 if sufficient source evidence; not a guarantee",
    "editorial_goal": "prioritize fewer complete narratives instead of 26 fragmented pieces",
    "is_original_synthesis": false
  },
  "report_mode": "original_clippings_not_ai_summary",
  "global_adviser": {
    "show_headline_roundup": false,
    "bilingual_format": "sentence_english_followed_immediately_by_chinese",
    "vocabulary_glossary": false,
    "keep_article_grammar": true,
    "advisor_sections": [
      "域内形势",
      "事实材料（英中逐句）",
      "顾问观察",
      "关注指标",
      "证据限制",
      "跨领域联动"
    ],
    "research_engine": "deterministic_evidence_bounded_v1",
    "note": "Framework and watchlist are rule-based, not fully sourced autonomous expert synthesis. Future optional LLM research adapters require suitable inference compute or provider."
  },
  "republication_licenses": {},
  "quote_policy": {
    "max_unlicensed_words_per_article": 25,
    "full_text_only_with": "human reviewed explicit source license allowing reproduction and Chinese translation",
    "model_generated_summaries": false,
    "generic_followup_templates": false
  },
  "output_sections": [
    "封面",
    "按主题排列的逐句英文原文与中文翻译",
    "篇末少量语法边注",
    "原媒体阅读全文链接"
  ]
}
