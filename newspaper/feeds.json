  "longread_max_chars": 18000,
  "longread_min_chars": 1200,
  "candidate_pool_per_category": 20,
  "source_limit_per_category": 2,
  "grammar_examples_per_article": 3,
  "ranking": {
    "weights": {
      "cross_border": 30,
      "scale": 25,
      "structural_change": 20,
      "new_development": 15,
      "publisher_breadth": 10
    },
    "description": "Evidence-labelled heuristic; publisher breadth is not proof or geographic independence.",
    "editorial_noise_gate": {
      "module": "source_quality.newsworthiness",
      "hard_exclude": [
        "advertorial",
        "promotional offers",
        "celebrity gossip",
        "sports results"
      ],
      "soft_penalty_keywords": true,
      "material_policy_exceptions": true
    }
  },
  "reading_policy": {
    "mode": "evidence_mapped_edited_report",
    "description": "Complete source-based edited reports, with paragraph evidence and checks; conservative extractive fallback when unavailable or rejected.",
    "display_links": false,
    "body": "english_original_sentence_then_matching_chinese",
    "commentary": "independent_email_body_ai"
  },
  "report_mode": "private_original_bilingual_newspaper",
  "global_adviser": {
    "show_headline_roundup": false,
    "bilingual_format": "sentence_english_followed_immediately_by_chinese",
    "vocabulary_glossary": false,
    "keep_article_grammar": true,
    "advisor_sections": [
      "域内形势",
      "事实材料（英中逐句）",
      "顾问观察",
      "关注指标",
      "证据限制",
      "跨领域联动"
    ],
    "research_engine": "deterministic_evidence_bounded_v1",
    "note": "Framework and watchlist are rule-based, not fully sourced autonomous expert synthesis. Future optional LLM research adapters require suitable inference compute or provider."
  },
  "political_major_event_extra": 2,
  "editorial_policy": {
    "political_minimum": 3,
    "political_regions_required": [
      "中国",
      "美国"
    ],
    "political_extra_if_material": 2,
    "political_shortfall_behavior": "log truthful shortfall, do not invent or replace with unrelated news",
    "frontier_technology_only": true,
    "avoid_entertainment_trailers": true,
    "examples_wanted": [
      "AI research breakthrough",
      "nuclear fusion",
      "superconductivity",
      "quantum computing",
      "physics",
      "semiconductor",
      "robotics"
    ],
    "article_editing": "Decision-maker complete reporting, ordinary 500-800 Chinese characters, important 900-1300, major exceptional longer. Source-based rewriting with evidence mapping and careful guarded fallback.",
    "translation": "offline with cautious terminology and alignment checks",
    "commentary_skill": "GLOBAL_STRATEGY_EDITOR.skill.md",
    "china_us_combined_quota": 3,
    "global_event_deduplication": true,
    "country_concentration_review": true
  },
  "edition_version": "0.9",
  "edition_target": {
    "usual_total_range": [
      13,
      16
    ],
    "do_not_pad": true,
    "allow_exceptional_major_news": true,
    "china_us_combined_quota": 3,
    "international_minimum_when_qualified": 3
  },
  "source_health_policy": {
    "record_feed_success_and_recent_item_counts": true,
    "record_unique_publisher_families": true,
    "inactive_sources_are_not_counted_as_live": true,
    "one_source_cannot_confirm_itself": true
  }
