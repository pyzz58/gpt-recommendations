MEDICAL_ONE_APP_MODE=mock
MEDICAL_ONE_ENVIRONMENT=development
MEDICAL_ONE_DATABASE_URL=postgresql+psycopg://medical_one_app:replace-local-app-password@127.0.0.1:5432/medical_one
MEDICAL_ONE_MIGRATION_DATABASE_URL=postgresql+psycopg://medical_one_migrator:replace-local-migrator-password@127.0.0.1:5432/medical_one
POSTGRES_APP_PASSWORD=replace-local-app-password
POSTGRES_MIGRATOR_PASSWORD=replace-local-migrator-password
MEDICAL_ONE_CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
MEDICAL_ONE_OFFICE_SOFFICE_PATH=/absolute/path/to/soffice
MEDICAL_ONE_OFFICE_PDFTOPPM_PATH=/absolute/path/to/pdftoppm
MEDICAL_ONE_OFFICE_PDF_FONT_PATH=/absolute/path/to/a-cjk-font.ttf
MEDICAL_ONE_NETWORK_MODE=offline
MEDICAL_ONE_RUNTIME_DIR=/absolute/path/outside/repository/runtime-state
MEDICAL_ONE_API_PORT=8000
MEDICAL_ONE_WEB_PORT=3000
MEDICAL_ONE_BACKUP_ROOT=/absolute/path/outside/repository/backups
MEDICAL_ONE_RESTORE_ROOT=/absolute/path/outside/repository/restore-checks
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
