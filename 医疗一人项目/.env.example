# Point MEDICAL_ONE_CONFIG_FILE at this file when it is stored outside the repository.
# Shell, Python and Next.js read the same source through scripts/medical-one.sh.
# Values from the parent process environment take precedence.
MEDICAL_ONE_APP_MODE=mock
MEDICAL_ONE_ENVIRONMENT=development
MEDICAL_ONE_DATABASE_URL=postgresql+psycopg://medical_one_app:replace-local-app-password@127.0.0.1:5432/medical_one
MEDICAL_ONE_MIGRATION_DATABASE_URL=postgresql+psycopg://medical_one_migrator:replace-local-migrator-password@127.0.0.1:5432/medical_one
POSTGRES_APP_PASSWORD=replace-local-app-password
POSTGRES_MIGRATOR_PASSWORD=replace-local-migrator-password
MEDICAL_ONE_CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
MEDICAL_ONE_OFFICE_SOFFICE_PATH=/absolute/path/to/soffice
MEDICAL_ONE_OFFICE_PDFTOPPM_PATH=/absolute/path/to/pdftoppm
MEDICAL_ONE_OFFICE_PDF_FONT_PATH=/absolute/path/to/a-cjk-font.ttf
MEDICAL_ONE_NETWORK_MODE=offline
MEDICAL_ONE_MODEL_PROVIDER=mock
MEDICAL_ONE_MODEL_PROVIDER_LIVE_ENABLED=false
MEDICAL_ONE_MODEL_PROVIDER_BASE_URL=https://provider.example/v1
MEDICAL_ONE_MODEL_PROVIDER_API_KEY=replace-only-for-authorized-live-check
MEDICAL_ONE_MODEL_PROVIDER_MODEL=replace-with-approved-model-id
MEDICAL_ONE_MODEL_PROVIDER_TIMEOUT_SECONDS=60
MEDICAL_ONE_MODEL_PROVIDER_MAX_CONTEXT_TOKENS=32000
MEDICAL_ONE_MODEL_PROVIDER_MAX_OUTPUT_TOKENS=4096
MEDICAL_ONE_MODEL_PROVIDER_MAX_COST_PER_CALL=
MEDICAL_ONE_MODEL_PROVIDER_INPUT_COST_PER_MILLION=
MEDICAL_ONE_MODEL_PROVIDER_OUTPUT_COST_PER_MILLION=
MEDICAL_ONE_MODEL_PROVIDER_CURRENCY=
MEDICAL_ONE_MAIL_ADAPTER=mock
MEDICAL_ONE_MAIL_SMTP_LIVE_ENABLED=false
MEDICAL_ONE_MAIL_SMTP_HOST=
MEDICAL_ONE_MAIL_SMTP_PORT=587
MEDICAL_ONE_MAIL_SMTP_SECURITY=starttls
MEDICAL_ONE_MAIL_SMTP_USERNAME=
MEDICAL_ONE_MAIL_SMTP_PASSWORD=
MEDICAL_ONE_MAIL_SMTP_FROM_ADDRESS=
MEDICAL_ONE_MAIL_SMTP_FROM_NAME=医疗一人项目
MEDICAL_ONE_MAIL_SMTP_TIMEOUT_SECONDS=30
MEDICAL_ONE_MAIL_SMTP_ALLOWED_RECIPIENTS=
MEDICAL_ONE_RUNTIME_DIR=/absolute/path/outside/repository/runtime-state
MEDICAL_ONE_API_PORT=8000
MEDICAL_ONE_WEB_PORT=3000
MEDICAL_ONE_BACKUP_ROOT=/absolute/path/outside/repository/backups
MEDICAL_ONE_RESTORE_ROOT=/absolute/path/outside/repository/restore-checks
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
