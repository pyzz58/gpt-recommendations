{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:medical-one-person:backup-snapshot:v1",
  "properties": {
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "project_id": {
      "format": "uuid",
      "title": "Project Id",
      "type": "string"
    },
    "format": {
      "title": "Format",
      "type": "string"
    },
    "file_name": {
      "title": "File Name",
      "type": "string"
    },
    "state": {
      "enum": [
        "completed",
        "failed"
      ],
      "title": "State",
      "type": "string"
    },
    "backup_sha256": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Backup Sha256"
    },
    "plaintext_sha256": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Plaintext Sha256"
    },
    "encrypted_size_bytes": {
      "title": "Encrypted Size Bytes",
      "type": "integer"
    },
    "manifest": {
      "additionalProperties": true,
      "title": "Manifest",
      "type": "object"
    },
    "error_code": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Error Code"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    }
  },
  "required": [
    "id",
    "project_id",
    "format",
    "file_name",
    "state",
    "backup_sha256",
    "plaintext_sha256",
    "encrypted_size_bytes",
    "manifest",
    "error_code",
    "created_at"
  ],
  "title": "BackupView",
  "type": "object",
  "description": "Backup metadata and manifest without a stored encryption key."
}
