{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:medical-one-person:workflow-definition:v1",
  "$defs": {
    "CriterionKind": {
      "enum": [
        "evidence",
        "professional_judgment",
        "decision",
        "review"
      ],
      "title": "CriterionKind",
      "type": "string"
    },
    "ExternalPrecondition": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "provider_type": {
          "minLength": 1,
          "title": "Provider Type",
          "type": "string"
        },
        "evidence_type": {
          "minLength": 1,
          "title": "Evidence Type",
          "type": "string"
        },
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        },
        "cannot_self_confirm": {
          "const": true,
          "default": true,
          "title": "Cannot Self Confirm",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "description",
        "provider_type",
        "evidence_type"
      ],
      "title": "ExternalPrecondition",
      "type": "object"
    },
    "Track": {
      "enum": [
        "pet_repurposing",
        "ivd",
        "device"
      ],
      "title": "Track",
      "type": "string"
    },
    "WorkflowCriterion": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/CriterionKind"
        },
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        },
        "requires_refs": {
          "default": true,
          "title": "Requires Refs",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "kind",
        "description"
      ],
      "title": "WorkflowCriterion",
      "type": "object"
    },
    "WorkflowPlanNode": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Key",
          "type": "string"
        },
        "task_type": {
          "minLength": 1,
          "title": "Task Type",
          "type": "string"
        },
        "purpose": {
          "minLength": 1,
          "title": "Purpose",
          "type": "string"
        },
        "assignee_role": {
          "pattern": "^A(0[1-9]|1[0-9]|2[0-6])$",
          "title": "Assignee Role",
          "type": "string"
        },
        "goal": {
          "minLength": 1,
          "title": "Goal",
          "type": "string"
        },
        "input_refs": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Input Refs",
          "type": "array"
        },
        "deliverable_schema": {
          "default": "agent_delivery.v1",
          "title": "Deliverable Schema",
          "type": "string"
        },
        "acceptance_policy": {
          "minLength": 1,
          "title": "Acceptance Policy",
          "type": "string"
        },
        "depends_on": {
          "items": {
            "type": "string"
          },
          "title": "Depends On",
          "type": "array"
        }
      },
      "required": [
        "key",
        "task_type",
        "purpose",
        "assignee_role",
        "goal",
        "input_refs",
        "acceptance_policy"
      ],
      "title": "WorkflowPlanNode",
      "type": "object"
    },
    "WorkflowStage": {
      "additionalProperties": false,
      "properties": {
        "stage_id": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Stage Id",
          "type": "string"
        },
        "sequence": {
          "minimum": 1,
          "title": "Sequence",
          "type": "integer"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "purpose": {
          "minLength": 1,
          "title": "Purpose",
          "type": "string"
        },
        "required_roles": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Required Roles",
          "type": "array"
        },
        "criteria": {
          "items": {
            "$ref": "#/$defs/WorkflowCriterion"
          },
          "minItems": 1,
          "title": "Criteria",
          "type": "array"
        },
        "required_inputs": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Required Inputs",
          "type": "array"
        },
        "required_outputs": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Required Outputs",
          "type": "array"
        },
        "review_policy": {
          "minLength": 1,
          "title": "Review Policy",
          "type": "string"
        },
        "failure_routes": {
          "additionalProperties": {
            "type": "string"
          },
          "minProperties": 1,
          "title": "Failure Routes",
          "type": "object"
        },
        "external_preconditions": {
          "items": {
            "$ref": "#/$defs/ExternalPrecondition"
          },
          "title": "External Preconditions",
          "type": "array"
        },
        "theory_refs": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Theory Refs",
          "type": "array"
        },
        "plan_nodes": {
          "items": {
            "$ref": "#/$defs/WorkflowPlanNode"
          },
          "minItems": 1,
          "title": "Plan Nodes",
          "type": "array"
        }
      },
      "required": [
        "stage_id",
        "sequence",
        "title",
        "purpose",
        "required_roles",
        "criteria",
        "required_inputs",
        "required_outputs",
        "review_policy",
        "failure_routes",
        "external_preconditions",
        "theory_refs",
        "plan_nodes"
      ],
      "title": "WorkflowStage",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "workflow_id": {
      "pattern": "^[a-z][a-z0-9_-]{0,63}$",
      "title": "Workflow Id",
      "type": "string"
    },
    "version": {
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    },
    "track": {
      "$ref": "#/$defs/Track"
    },
    "title": {
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "purpose": {
      "minLength": 1,
      "title": "Purpose",
      "type": "string"
    },
    "applicability": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Applicability",
      "type": "array"
    },
    "non_goals": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Non Goals",
      "type": "array"
    },
    "stages": {
      "items": {
        "$ref": "#/$defs/WorkflowStage"
      },
      "minItems": 1,
      "title": "Stages",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "workflow_id",
    "version",
    "track",
    "title",
    "purpose",
    "applicability",
    "non_goals",
    "stages"
  ],
  "title": "WorkflowDefinition",
  "type": "object",
  "description": "Strict three-domain workflow contract; config validity does not prove scientific or regulatory applicability."
}
